rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() == 12 && id.matches('^[0-9]{12}$');
    }

    function isValidCalon(data) {
      return data.cleanMykid is string 
        && data.cleanMykid.size() == 12 
        && data.cleanMykid.matches('^[0-9]{12}$')
        && data.nama is string 
        && data.nama.size() > 0 
        && data.nama.size() <= 150
        && (data.status == 'BERJAYA' || data.status == 'TIDAK BERJAYA');
    }

    // Koleksi calon_2027
    match /calon_2027/{cleanMykid} {
      // Ibu bapa boleh mencari rekod 1 calon mengikut No MyKid
      allow get: if isValidId(cleanMykid);

      // Pentadbir boleh membaca senarai penuh (list)
      allow list: if true;

      // Cipta rekod (mematuhi skema sah)
      allow create: if isValidId(cleanMykid) && isValidCalon(request.resource.data);

      // Kemas kini rekod (sama ada kemaskini pentadbir atau pengesahan jawapan oleh ibu bapa)
      allow update: if isValidId(cleanMykid);

      // Padam rekod
      allow delete: if isValidId(cleanMykid);
    }
  }
}
