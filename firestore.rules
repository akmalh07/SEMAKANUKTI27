rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() == 12 && id.matches('^[0-9]{12}$');
    }

    function isValidCalon(data) {
      return data.cleanMykid is string 
        && data.cleanMykid.size() == 12 
        && data.cleanMykid.matches('^[0-9]{12}$')
        && data.nama is string 
        && data.nama.size() > 0 
        && data.nama.size() <= 150
        && (data.status == 'BERJAYA' || data.status == 'TIDAK BERJAYA');
    }

    // Koleksi calon_2027
    match /calon_2027/{cleanMykid} {
      // Ibu bapa dibenarkan membuat 'get' (carian 1 rekod mengikut MyKid)
      allow get: if isValidId(cleanMykid);

      // Pentadbir boleh membaca senarai penuh (list) dan menguruskan rekod (create, update, delete)
      allow list: if true;
      allow create: if isValidId(cleanMykid) && isValidCalon(request.resource.data);
      allow update: if isValidId(cleanMykid) && isValidCalon(request.resource.data);
      allow delete: if isValidId(cleanMykid);
    }
  }
}
